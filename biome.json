{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!next-env.d.ts", "!lib/generated", "!lib/transparencia/schema.d.ts"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "noAriaUnsupportedElements": "warn",
        "useAltText": "warn",
        "useAriaPropsForRole": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useValidAriaProps": "warn",
        "useValidAriaValues": "warn"
      },
      "complexity": {
        "noArguments": "error",
        "noBannedTypes": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "warn",
        "noChildrenProp": "error",
        "noNestedComponentDefinitions": "error",
        "noNextAsyncClientComponent": "warn",
        "noRenderReturnValue": "error",
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": {
          "level": "warn",
          "options": { "reportUnnecessaryDependencies": false }
        },
        "useHookAtTopLevel": "error",
        "useInlineScriptId": "error",
        "useJsxKeyInIterable": "error"
      },
      "nursery": {
        "useReactCompiler": "error"
      },
      "performance": {
        "noImgElement": "warn",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "warn",
        "useGoogleFontPreconnect": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noHeadElement": "warn",
        "noNamespace": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "useSpreadOverApply": "error"
      },
      "suspicious": {
        "noCommentText": "error",
        "noDocumentImportInPage": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateJsxProps": "error",
        "noEmptyInterface": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noHeadImportInDocument": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noReactStringRefs": "error",
        "noTsIgnore": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnusedExpressions": "warn",
        "noVar": "error",
        "useGoogleFontDisplay": "warn",
        "useNamespaceKeyword": "error"
      }
    }
  }
}
