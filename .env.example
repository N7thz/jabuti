# === APIs de dados ===============================================

# Portal da Transparência — chave gerada em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=

# === Login =======================================================

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth — gere o segredo com: openssl rand -base64 32
# BETTER_AUTH_URL é o endereço onde o app roda: callbacks do login e links dos emails de login
# (confirmação e redefinição de senha). Em produção: https://portal-jabuti.com.br
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# === Banco de dados ==============================================

# Neon Postgres — https://console.neon.tech (Connection string)
# DATABASE_URL: conexão com pooling (host com "-pooler"), usada pelo app.
# DIRECT_URL: conexão direta (sem "-pooler"), usada por prisma migrate/studio (prisma.config.ts).
#   Na Vercel/Neon CLI ela vem como DATABASE_URL_UNPOOLED, que também é aceita; basta uma das duas.
DATABASE_URL=
DIRECT_URL=

# === Site ========================================================

# Endereço público do portal, usado no sitemap, no robots.txt e nas imagens de compartilhamento
# (os emails de login usam o BETTER_AUTH_URL). Sem ele, vale o BETTER_AUTH_URL.
# Em produção: https://portal-jabuti.com.br
NEXT_PUBLIC_SITE_URL=

# === Email (Resend) ==============================================

# Envio de email pelo Resend — chave em https://resend.com/api-keys
# Os remetentes precisam ser de um domínio verificado no Resend (Domains > Add domain, com os registros
# DNS que ele pede): use endereços de portal-jabuti.com.br. Remetente de Gmail, Hotmail e afins é recusado.
# Com os dois remetentes vazios, vale o remetente de teste (onboarding@resend.dev), que só entrega para o
# email dono da conta do Resend.
RESEND_API_KEY=
# Formulário de sugestões (/feedback): FEEDBACK_EMAIL recebe as mensagens (vários separados por vírgula);
# o "responder" vai para quem escreveu.
FEEDBACK_EMAIL=
# Remetente do /feedback. Ex.: Jabuti <contato@portal-jabuti.com.br>. Vazio, vale o EMAIL_REMETENTE.
FEEDBACK_REMETENTE=
# Remetente do login (confirmação de email e redefinição de senha).
# Ex.: Jabuti <avisos@portal-jabuti.com.br>. Vazio, vale o FEEDBACK_REMETENTE.
EMAIL_REMETENTE=

# === Admin =======================================================

# Emails com acesso ao painel de admin (/admin/apoiadores, o mural de apoiadores de /apoie), separados por
# vírgula. A pessoa precisa entrar com um desses emails, já confirmado. Vazio: ninguém é admin.
ADMIN_EMAILS=

# === Apoio financeiro (/apoie) ===================================

# Só aparece no portal o que estiver preenchido. Sem nada, a página /apoie mostra só as formas de
# ajudar sem dinheiro (compartilhar, avisar de erros, contribuir no código).
# Pix: chave (CPF, CNPJ, email, telefone com +55 ou chave aleatória), nome de quem recebe (até 25
# letras, como no banco) e cidade (até 15). O QR Code e o copia e cola são gerados pelo portal.
APOIO_PIX_CHAVE=
APOIO_PIX_NOME=
APOIO_PIX_CIDADE=
# Apoio mensal: links https das páginas de apoio.
APOIO_GITHUB_SPONSORS_URL=
APOIO_APOIASE_URL=
# Repositório mostrado em "contribuir no código". Vazio, vale https://github.com/N7thz/jabuti.
NEXT_PUBLIC_REPOSITORIO_URL=
