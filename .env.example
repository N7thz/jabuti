# === APIs de dados ===============================================

# Portal da Transparência — chave gerada em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=

# === Login =======================================================

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth — gere o segredo com: openssl rand -base64 32
# BETTER_AUTH_URL é o endereço onde o app roda (callbacks do login).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# === Banco de dados ==============================================

# Neon Postgres — https://console.neon.tech (Connection string)
# DATABASE_URL: conexão com pooling (host com "-pooler"), usada pelo app.
# DIRECT_URL: conexão direta (sem "-pooler"), usada por prisma migrate/studio (prisma.config.ts).
#   Na Vercel/Neon CLI ela vem como DATABASE_URL_UNPOOLED, que também é aceita; basta uma das duas.
DATABASE_URL=
DIRECT_URL=

# === Site ========================================================

# Endereço público do portal, usado no sitemap, no robots.txt e nas imagens de compartilhamento.
# Sem ele, vale o BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL=

# === Feedback ====================================================

# Formulário de sugestões (/feedback): envio por email pelo Resend — https://resend.com/api-keys
# FEEDBACK_EMAIL recebe as mensagens (vários separados por vírgula); o "responder" vai para quem escreveu.
# FEEDBACK_REMETENTE precisa ser de um domínio verificado no Resend. Vazio, vale o remetente de teste
# (onboarding@resend.dev), que só entrega para o email dono da conta do Resend.
RESEND_API_KEY=
FEEDBACK_EMAIL=
FEEDBACK_REMETENTE=
# Remetente dos emails do login (confirmação de email e redefinição de senha). Vazio, vale o FEEDBACK_REMETENTE.
# Com o remetente de teste do Resend, esses emails só chegam ao dono da conta do Resend.
EMAIL_REMETENTE=
