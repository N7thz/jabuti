# Chave gerada em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Neon Postgres — https://console.neon.tech (Connection string)
# DATABASE_URL: conexão com pooling (host com "-pooler"), usada pelo app.
# DIRECT_URL: conexão direta (sem "-pooler"), usada por prisma migrate/studio.
#   Na Vercel/Neon CLI ela vem como DATABASE_URL_UNPOOLED, que também é aceita.
DATABASE_URL=
DIRECT_URL=
